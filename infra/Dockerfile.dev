FROM postgres:18.6-bookworm@sha256:3725f4e2499eef5134592b3b4ab79a543ed7f8e533b05b5b637af926630f6650 AS pg-tools
# Test-only logical dump executable and its isolated official-image libraries.
RUN mkdir -p /opt/forja-pg-tools/bin /opt/forja-pg-tools/lib && cp /usr/lib/postgresql/18/bin/pg_dump /opt/forja-pg-tools/bin/ && ldd /usr/lib/postgresql/18/bin/pg_dump | awk '/=> \/[a-z]/ { print $3 }' | xargs -r cp -t /opt/forja-pg-tools/lib/
FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
RUN apt-get update && apt-get install -y --no-install-recommends openssl=3.0.22-1~deb12u1 && rm -rf /var/lib/apt/lists/*
RUN npm install --global npm@11.18.0
COPY --from=pg-tools /opt/forja-pg-tools /opt/forja-pg-tools
WORKDIR /workspace/apps/api
RUN mkdir -p node_modules && chown -R node:node /workspace
USER node
