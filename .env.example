# Non-secret, isolated local Docker settings only. scripts/dev setup creates secret files.
NODE_ENV=development
APP_BIND_HOST=0.0.0.0
PORT=3001
DB_HOST=postgres
DB_PORT=5432
DB_NAME=forja
DB_USER=forja_app
DB_PASSWORD_FILE=/run/secrets/api-password
DB_SSL_MODE=disable
MIGRATION_USER=forja_migrator
MIGRATION_PASSWORD_FILE=/run/secrets/migration-password
# setup replaces these with the workstation user/group for non-root bind mounts.
LOCAL_UID=1000
LOCAL_GID=1000
# Host loopback port; change if another local service uses 3010.
FORJA_API_PORT=3010
# Development-only crypto custody; scripts/dev crypto-open materializes the Keychain secret.
CRYPTO_PROVIDER=local-development
CRYPTO_ENVIRONMENT_ID=forja-development
CRYPTO_SECRET_FILE=/run/secrets/development-data-key
CRYPTO_CONTROL_DIRECTORY=/run/forja-control
# Real operator-approved OIDC enrollment; leave absent until available. No runtime fixture/provider.
# OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_REDIRECT_URI are public settings; see docs/identity.md.
